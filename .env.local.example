# Copie este arquivo para .env.local e preencha.

# Ollama (LLM local). Padrões já assumem uma instalação local comum.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Janela de contexto em tokens. Prompts com vaga + CV + dossiê passam de 4096; 8192 é o padrão.
# OLLAMA_NUM_CTX=8192
# Prazo máximo (ms) para o Ollama responder uma chamada. Padrão: 900000 (15 min).
# OLLAMA_TIMEOUT_MS=900000

# Tavily Search API (free tier, sem cartão) — usada só na etapa de pesquisa (Research Dossier).
# Crie uma chave gratuita em https://tavily.com/
TAVILY_API_KEY=
