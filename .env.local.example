# Copy this file to .env.local and fill it in.

# Ollama (local LLM). The defaults assume a common local install.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Context window in tokens. Prompts with job description + resume + dossier exceed 4096; 8192 is the default.
# OLLAMA_NUM_CTX=8192
# Maximum time (ms) to wait for Ollama to answer one call. Default: 900000 (15 min).
# OLLAMA_TIMEOUT_MS=900000

# Tavily Search API (free tier, no card). Only used by the research (Research Dossier) and Job Search steps.
# Create a free key at https://tavily.com/
TAVILY_API_KEY=
