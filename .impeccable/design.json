  "narrative": {
    "northStar": "The Friendly Study Room",
    "overview": "Intreview is a calm place to concentrate before something stressful. Surfaces are soft and mostly neutral, one indigo accent marks the thing that matters on a screen, and a faint glow in the background keeps the page from feeling like a blank form. Motion exists to acknowledge and orient, never to perform. Light and dark themes are both first-class, and every screen is designed to read in PT-BR and English.",
    "keyCharacteristics": [
      "One accent (indigo) on a near-neutral gray system; neutrals carry no hue.",
      "Soft cards with a hairline ring and a barely-there shadow; depth comes from tone and ring, not heavy shadow.",
      "Calm, precise controls: moderate radius, thin borders, fast and quiet feedback.",
      "A fixed, decorative ambient background behind all pages.",
      "Motion is short, ease-out, and respects reduced-motion."
    ],
    "rules": [
      {
        "name": "The Friendly Palette Rule",
        "body": "Indigo owns every primary action and the candidate's voice. Violet, pink, amber, emerald and sky are for company tiles, feature chips, work-mode badges, the aurora and celebrations only, never for buttons or links.",
        "section": "colors"
      },
      {
        "name": "The Tinted-Wash Rule",
        "body": "Selection and emphasis use the primary at low alpha or the Indigo Wash fill, never a new color.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Do not add a second sans or serif; use weight and size.",
        "section": "typography"
      },
      {
        "name": "The Balanced Heading Rule",
        "body": "Headings use text-wrap: balance.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Touched Rule",
        "body": "Elevation appears as a response to hover, never as decoration at rest.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use primary indigo for the single most important action or state on a screen.",
      "Do switch states with short ease-out transitions (150-360ms) and a fade-only path for reduced motion.",
      "Do keep copy in the candidate's language and run every new string through both PT-BR and EN.",
      "Do keep working surfaces (role detail, job search) editable in place with Edit / Save / Cancel.",
      "Do show honest states: \"Unidentified\" work mode, no sources found, search failed."
    ],
    "donts": [
      "Don't use transition: all, bounce or elastic easing, or entrance animations that make users wait on every page.",
      "Don't put gradient text, heavy offset shadows, or decorative glass on content surfaces.",
      "Don't nest cards inside cards; use a divider or muted panel instead.",
      "Don't add a second typeface.",
      "Don't use the supporting hues on buttons or links, or add colored side borders on cards and alerts."
    ]
  }
}