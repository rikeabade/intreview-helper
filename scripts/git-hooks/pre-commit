#!/usr/bin/env bash
# Extra safety net against leaking personal data or API keys.
# Enabled with: git config core.hooksPath scripts/git-hooks
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked=0

while IFS= read -r file; do
  [ -z "$file" ] && continue

  if [[ "$file" == data/* ]]; then
    echo "BLOCKED: '$file' is inside data/ — it likely holds a real resume, job description or interview transcript and should not be committed." >&2
    blocked=1
  fi

  if [[ "$file" == .env* && "$file" != ".env.local.example" && "$file" != ".env.example" ]]; then
    echo "BLOCKED: '$file' looks like an .env file with real secrets. Only the (empty) .env.local.example should be committed." >&2
    blocked=1
  fi
done <<< "$staged_files"

# Lightweight scan for common API key patterns in the staged content.
secret_pattern='tvly-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}'
if git diff --cached -U0 -- . ':!package-lock.json' | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -qE "$secret_pattern"; then
  echo "BLOCKED: the staged diff looks like it contains an API key (tvly-/sk-/AKIA/AIza pattern). Review it before committing." >&2
  blocked=1
fi

if [ "$blocked" -eq 1 ]; then
  echo "" >&2
  echo "Commit aborted. If this is a false positive, use 'git commit --no-verify' (carefully)." >&2
  exit 1
fi

exit 0
