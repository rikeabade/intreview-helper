#!/usr/bin/env bash
# Rede de segurança extra contra vazar dados pessoais ou chaves de API.
# Ativado via: git config core.hooksPath scripts/git-hooks
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked=0

while IFS= read -r file; do
  [ -z "$file" ] && continue

  if [[ "$file" == data/* ]]; then
    echo "BLOQUEADO: '$file' está dentro de data/ — isso provavelmente contém CV, Job Description ou transcripts de entrevista reais. Não deveria ser commitado." >&2
    blocked=1
  fi

  if [[ "$file" == .env* && "$file" != ".env.local.example" && "$file" != ".env.example" ]]; then
    echo "BLOQUEADO: '$file' parece um arquivo .env com segredos reais. Só .env.local.example (vazio) deveria ser commitado." >&2
    blocked=1
  fi
done <<< "$staged_files"

# Varredura leve de padrões comuns de API key no conteúdo staged.
secret_pattern='tvly-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}'
if git diff --cached -U0 -- . ':!package-lock.json' | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -qE "$secret_pattern"; then
  echo "BLOQUEADO: o diff staged parece conter uma chave de API (padrão tvly-/sk-/AKIA/AIza). Revise antes de commitar." >&2
  blocked=1
fi

if [ "$blocked" -eq 1 ]; then
  echo "" >&2
  echo "Commit abortado. Se isso for um falso positivo, use 'git commit --no-verify' (com cuidado)." >&2
  exit 1
fi

exit 0
