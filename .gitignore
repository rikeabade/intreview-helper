# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nunca commitar segredos reais; o template .env.local.example é a exceção)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados pessoais do usuário (CV, JD, transcripts de entrevista) — nunca commitar
data/

# config local de ferramentas de dev (não faz parte do produto)
.claude/

# documentos de trabalho gerados pelos skills de desenvolvimento (ficam só na máquina de quem desenvolve)
/GLOSSARY.md
/PRODUCT.md
/DESIGN.md
/.impeccable/
/docs/adr/
